# Copy to .env and adjust as needed.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Development database. The defaults match docker-compose.yml (host port 5433).
# For a locally installed PostgreSQL, run scripts/create-local-databases.sql
# once and change the port to 5432.
DATABASE_URL=postgres://bank:bank@localhost:5433/bank_dev

# Test database. Used instead of DATABASE_URL whenever NODE_ENV=test, and its
# name must end in "_test" so tests can never truncate development data.
TEST_DATABASE_URL=postgres://bank:bank@localhost:5433/bank_test

# Maximum number of connections in the pool.
DB_POOL_MAX=10

# Key used to sign session tokens. Required, at least 32 characters.
# The value below is a placeholder for local development only: the API refuses
# to start with it when NODE_ENV=production. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=local-development-only-secret-change-me

# How long a login session lasts, in minutes.
SESSION_TTL_MINUTES=60
