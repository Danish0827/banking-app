# Copy to .env and adjust as needed.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Development database. The defaults match docker-compose.yml (host port 5433).
# For a locally installed PostgreSQL, run scripts/create-local-databases.sql
# once and change the port to 5432.
DATABASE_URL=postgres://bank:bank@localhost:5433/bank_dev

# Test database. Used instead of DATABASE_URL whenever NODE_ENV=test, and its
# name must end in "_test" so tests can never truncate development data.
TEST_DATABASE_URL=postgres://bank:bank@localhost:5433/bank_test

# Maximum number of connections in the pool.
DB_POOL_MAX=10

# How long a request waits for a free pool connection, how long unused
# connections stay open, and the limit for any single statement (also applied
# to a transaction left idle while holding locks), all in milliseconds.
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000

# On SIGTERM/SIGINT, how long in-flight requests get before a forced exit (ms).
SHUTDOWN_TIMEOUT_MS=10000

# Key used to sign session tokens. Required, at least 32 characters.
# The value below is a placeholder for local development only: the API refuses
# to start with it when NODE_ENV=production. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=local-development-only-secret-change-me

# How long a login session lasts, in minutes.
SESSION_TTL_MINUTES=60

# Browser origins other than the web app's own that may call the API with
# credentials, comma-separated and exact (e.g. https://app.example.com).
# Leave empty when the web app reaches the API through its /api proxy.
CORS_ALLOWED_ORIGINS=

# Deposits, withdrawals and transfers allowed per customer per minute.
MONEY_RATE_LIMIT_PER_MINUTE=30
